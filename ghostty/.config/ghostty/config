font-family = ComicCode Nerd Font, Noto Color Emoji
font-size = 9
font-feature = -calt
font-feature = -liga
font-feature = -dlig

cursor-style = block

mouse-hide-while-typing = true

theme = GruvboxDark

window-padding-x = 4
window-padding-y = 4

shell-integration = fish
shell-integration-features = no-cursor

macos-titlebar-style = hidden
window-decoration = false
